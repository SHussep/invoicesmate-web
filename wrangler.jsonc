{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "invoicesmate-web",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  }
}
